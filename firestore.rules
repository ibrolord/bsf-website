rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isAuth() {
      return request.auth != null;
    }
    function userDocExists() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }
    // Supports both legacy `role` (string) and new `roles` (array) fields
    function hasRole(role) {
      return userDocExists() && (
        ('roles' in getUserDoc() && role in getUserDoc().roles) ||
        ('role' in getUserDoc() && getUserDoc().role == role)
      );
    }
    function isAdmin() {
      return hasRole('admin') || isSuperAdmin();
    }
    function canParticipateInForum() {
      return hasRole('volunteer') ||
        hasRole('team_lead') ||
        hasRole('program_lead') ||
        hasRole('finance') ||
        hasRole('moderator') ||
        hasRole('admin') ||
        hasRole('superadmin') ||
        isSuperAdmin();
    }
    function hasAnyRole() {
      return userDocExists() && (
        ('roles' in getUserDoc() && getUserDoc().roles.size() > 0) ||
        ('role' in getUserDoc() && getUserDoc().role != null && getUserDoc().role != '')
      );
    }
    function hasLegacyPermission(permission) {
      return (
        (permission == 'users.view' && (hasRole('admin') || hasRole('viewer'))) ||
        (permission == 'users.assign_permissions' && hasRole('admin')) ||
        (permission == 'sponsors.view' && (
          hasRole('admin') ||
          hasRole('program_lead') ||
          hasRole('finance') ||
          hasRole('volunteer') ||
          hasRole('viewer')
        )) ||
        (permission == 'sponsors.edit' && hasRole('admin')) ||
        (permission == 'blog.create' && (
          hasRole('admin') ||
          hasRole('program_lead') ||
          hasRole('comms') ||
          hasRole('volunteer')
        )) ||
        (permission == 'blog.edit_any' && (
          hasRole('admin') ||
          hasRole('program_lead') ||
          hasRole('comms')
        )) ||
        (permission == 'blog.approve' && (
          hasRole('admin') ||
          hasRole('program_lead') ||
          hasRole('comms')
        ))
      );
    }
    function hasPermission(permission) {
      return isSuperAdmin() || (userDocExists() && (
        ('permissions' in getUserDoc() && permission in getUserDoc().permissions) ||
        hasLegacyPermission(permission)
      ));
    }
    function isSignedInEmail(email) {
      return isAuth() &&
        email is string &&
        request.auth.token.email is string &&
        request.auth.token.email == email;
    }
    function isSuperAdmin() {
      return isAuth() && request.auth.token.email == 'admin@bigsisterfoundation.org';
    }

    // ── Public pages: anyone can read, team members can write ──
    match /scholars/{docId} {
      allow read: if true;
      allow write: if hasAnyRole();

      match /milestones/{milestoneId} {
        allow read: if true;
        allow write: if hasAnyRole();
      }
    }
    match /schools/{docId} {
      allow read: if true;
      allow write: if hasAnyRole();
    }
    match /ledger/{docId} {
      allow read: if true;
      allow create: if hasAnyRole();
      // Any team member can update/delete (needed for 3-vote consensus auto-apply)
      allow update, delete: if hasAnyRole();
    }
    match /events/{docId} {
      allow read: if true;
      // Team members can manage event data; public page has no write path here.
      allow update: if hasAnyRole();
      allow create, delete: if hasAnyRole();
    }
    match /goals/{docId} {
      allow read: if true;
      allow create: if hasAnyRole();
      // Allow public updates for donation progress
      allow update: if true;
      allow delete: if isAdmin();
    }
    match /forums/{docId} {
      allow read: if true;
      allow write: if hasAnyRole();
    }
    match /forum_replies/{docId} {
      allow read: if true;
      allow write: if hasAnyRole();
    }
    match /announcements/{docId} {
      allow read: if true;
      allow write: if hasAnyRole();
    }
    match /outreach/{docId} {
      allow read: if true;
      allow write: if hasAnyRole();
    }

    // ── Public forms: visitors can create, only team can manage ──
    match /volunteer_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if hasAnyRole();
    }
    match /invites/{docId} {
      allow read: if true;
      allow write: if hasAnyRole();
    }
    match /donations/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if hasAnyRole();
    }
    match /ideas/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if hasAnyRole();
    }
    match /blog_posts/{docId} {
      allow read: if
        resource.data.status == 'approved' ||
        resource.data.aiGenerated == true ||
        hasPermission('blog.edit_any') ||
        hasPermission('blog.approve') ||
        isSignedInEmail(resource.data.submittedBy);
      allow create: if
        hasPermission('blog.create') &&
        request.resource.data.status == 'pending' &&
        isSignedInEmail(request.resource.data.submittedBy);
      allow update, delete: if hasPermission('blog.edit_any') || hasPermission('blog.approve');
    }
    match /votes/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if hasAnyRole();
    }
    match /forum_threads/{docId} {
      allow read: if true;
      allow create, update, delete: if canParticipateInForum();

      match /replies/{replyId} {
        allow read: if true;
        allow create, update, delete: if canParticipateInForum();
      }
    }

    // ── Communities ──
    match /communities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Sponsor dashboard ──
    match /sponsors/{docId} {
      allow create: if
        isAuth() &&
        docId == request.auth.token.email &&
        request.resource.data.email == request.auth.token.email;
      allow read: if
        hasPermission('sponsors.view') ||
        hasPermission('sponsors.edit') ||
        isSignedInEmail(docId) ||
        isSignedInEmail(resource.data.email);
      allow update: if
        hasPermission('sponsors.edit') ||
        isSignedInEmail(docId) ||
        isSignedInEmail(resource.data.email);
      allow delete: if hasPermission('sponsors.edit');
    }
    match /sponsor_notes/{docId} {
      allow read: if hasAnyRole() || (isAuth() && docId == request.auth.token.email);
      allow write: if hasAnyRole() || (isAuth() && docId == request.auth.token.email);
    }

    // ── Admin-only collections ──
    match /admins/{docId} {
      allow read: if hasAnyRole();
      allow write: if isAdmin() || isSuperAdmin();
    }
    match /users/{docId} {
      allow read: if
        isSignedInEmail(docId) ||
        hasPermission('users.view') ||
        hasPermission('users.assign_permissions');
      allow write: if hasPermission('users.assign_permissions');
    }
    match /audit_log/{docId} {
      allow read: if hasAnyRole();
      // Team members can write audit entries (append-only)
      allow create: if hasAnyRole();
      allow update, delete: if false;
    }
    match /volunteers/{docId} {
      allow read, write: if hasAnyRole();
    }
    match /teams/{docId} {
      allow read, write: if hasAnyRole();
    }
    match /team_forums/{docId} {
      allow read, write: if hasAnyRole();

      match /replies/{replyId} {
        allow read, write: if hasAnyRole();
      }
    }
    match /team_forum_replies/{docId} {
      allow read, write: if hasAnyRole();
    }
    match /tasks/{docId} {
      allow read, write: if hasAnyRole();
    }
    match /volunteer_logs/{docId} {
      allow read, write: if hasAnyRole();
    }
    match /shoutouts/{docId} {
      allow read: if isAuth();
      allow write: if hasAnyRole();
    }
    match /notifications/{docId} {
      allow read, write: if hasAnyRole();
    }
    match /scholar_expenses/{docId} {
      allow read, write: if hasAnyRole();
    }
    match /school_notes/{docId} {
      allow read, write: if hasAnyRole();
    }
    match /ledger_requests/{docId} {
      allow read: if hasAnyRole();
      allow create: if hasAnyRole();
      // Any team member can vote (update); admin can override/delete
      allow update: if hasAnyRole();
      allow delete: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ── Deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
